#!/bin/sh
# Runs scripts/check.sh before every push (installed by scripts/install-hooks.sh).
# Skip once with: git push --no-verify
root=$(git rev-parse --show-toplevel)
# documentation-only pushes need no build
if git diff --quiet @{push} -- src .github packaging 2>/dev/null; then
    exit 0
fi
exec "$root/scripts/check.sh"
